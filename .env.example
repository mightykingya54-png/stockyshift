SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-app.ngrok.io
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders

# Email provider (Mailtrap, SMTP2GO, Resend, etc.)
# For Mailtrap: SMTP_HOST=live.smtp.mailtrap.io, SMTP_USER=api, SMTP_PASS=your_api_key
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=your_mailtrap_api_key
FROM_EMAIL=purchase-orders@your-app.com
APP_URL=https://your-app.com
PORT=3000
SESSION_SECRET=generate-a-random-string-here
