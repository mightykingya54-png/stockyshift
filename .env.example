SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-app.ngrok.io
SCOPES=write_inventory,read_inventory,read_products,read_locations

# Email provider (Resend recommended for production)
# Resend SMTP: smtp.resend.com, username=resend, password=<Resend API key>
# Mailtrap (dev): SMTP_HOST=live.smtp.mailtrap.io, SMTP_USER=api, SMTP_PASS=your_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxx
# Must be a domain verified in your email provider
FROM_EMAIL=purchase-orders@stockyshift.com

# Contact emails for Privacy Policy & Terms of Service pages.
# Set up email forwarding at your domain registrar so these actually reach you.
CONTACT_PRIVACY=privacy@stockyshift.com
CONTACT_LEGAL=legal@stockyshift.com

APP_URL=https://stockyshift.com
PORT=3000
SESSION_SECRET=generate-a-random-string-here

# Testing billing on a DEV store: normally dev stores auto-activate the trial
# and the real App Pricing page is never shown. Set this to 'true' ONLY on
# a test env to force your dev store through the real billing checkout
# (dev auto-trial skipped, /api/billing/create returns the real confirmation
# URL as a test subscription). Leave unset in production.
# DEV_SHOW_BILLING=true
